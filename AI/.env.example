# Copy to .env. Never commit your real keys.
GOOGLE_API_KEY=
# Two DIFFERENT random secrets, at least 24 characters each.
AI_SERVICE_KEY=
AI_ADMIN_KEY=

GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Local MVP: no database installation required.
DATABASE_URL=sqlite:///./data/ai.db
# PostgreSQL alternative (see compose.yaml):
# DATABASE_URL=postgresql+psycopg://toeic_ai:your_password@localhost:5433/toeic_ai

CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=5
# Cosine similarity threshold; calibrate against your real TOEIC corpus.
MIN_SIMILARITY=0.55
PROVIDER_TIMEOUT_SECONDS=45
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENT_CHARACTERS=200000
MAX_DOCUMENT_CHUNKS=300
