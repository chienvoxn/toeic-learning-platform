# Mẫu cấu hình Gemini. Chạy scripts/init_env.py để chuẩn bị AI/.env.
# Chỉ điền key thật trong .env; không commit hoặc gửi key cho frontend.
GOOGLE_API_KEY=

# Hai khóa API nội bộ khác nhau, mỗi khóa tối thiểu 24 ký tự.
# init_env.py tự tạo nếu thiếu hoặc không hợp lệ.
AI_SERVICE_KEY=
AI_ADMIN_KEY=

# Model chat và embedding của Gemini.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768


POSTGRES_PASSWORD=
# init_env.py generates POSTGRES_PASSWORD and a URL-encoded PostgreSQL URL.
DATABASE_URL=
# Nếu đổi provider/model embedding, số chiều hoặc cách chia đoạn, nạp lại học liệu
# vào index mới. Không dùng lẫn vector từ các cấu hình khác nhau.

# PostgreSQL + pgvector is required for runtime; local port 5433.
# DATABASE_URL=postgresql+psycopg://toeic_ai:your_password@localhost:5433/toeic_ai
# Mật khẩu có ký tự đặc biệt trong DATABASE_URL cần được URL-encode.

# Chia đoạn theo ký tự; CHUNK_OVERLAP phải nhỏ hơn CHUNK_SIZE.
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=5

# Ngưỡng cosine cần đánh giá theo học liệu thực tế.
MIN_SIMILARITY=0.55

# Timeout gọi provider (giây).
PROVIDER_TIMEOUT_SECONDS=45

# Giới hạn nạp học liệu: 5 MiB/file, 200.000 ký tự, 300 đoạn.
MAX_UPLOAD_BYTES=5242880
MAX_DOCUMENT_CHARACTERS=200000
MAX_DOCUMENT_CHUNKS=300
